[Unit]
Description=Schrott-MCP hourly owner check-in
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/schrott-mcp-checkin.sh
# Ein haengender oneshot darf den Timer nie wieder blockieren: ohne dieses
# Limit blieb der Dienst am 11.11.2026 zwei Tage im Status "activating"
# (TimeoutStartUSec=infinity) und der Timer feuerte nicht mehr.
#
# 30 Minuten statt 5: ein Check-in, der mitten in der Arbeit per SIGTERM
# gekillt wird, hinterlaesst die Session im Zustand "interrupted" - und der
# Welle-Job (--continue auf dieselbe Session) bricht dann sofort ab. So
# sind am 14.11. bis 15.11.2026 acht Wellen-Runs hintereinander gescheitert.
TimeoutStartSec=1800
# SIGINT statt SIGTERM: opencode schliesst die Session damit sauber ab,
# statt sie als "interrupted" zu hinterlassen.
KillSignal=SIGINT
# Der Check-in faehrt eine EIGENE frische Session (seit 15.11.2026), nicht
# mehr die der 6h-Welle. KillMode=control-group raeumt den gesamten
# opencode-Prozessbaum ab, wenn das 30-Minuten-Limit greift.
KillMode=control-group
# 0 = erfolgreich, 130 = SIGINT (der gewoehnliche Abbruch durch den Timeout
# oben), 143 = SIGTERM. Der Timeout des Check-ins ist im Normalfall der
# erwartete Fall, kein Fehler.
SuccessExitStatus=0 130 143
